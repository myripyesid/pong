CC = gcc CFLAGS = -Wall -Wextra -pthread -Iinclude -g # Objetivos principales all: server client # Compilación del Servidor server: server/main.c $(CC) $(CFLAGS) server/main.c -o server # Compilación del Cliente client: client/main.c $(CC) $(CFLAGS) client/main.c -o client # Limpieza de binarios y archivos temporales clean: rm -f server client \*.o server/\*.o client/\*.o @echo "Limpieza completada." .PHONY: all clean
